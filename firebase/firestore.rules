rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public catalogue documents may be readable by signed-in users.
    // Catalogue writes are reserved for trusted administrative tooling.
    match /marketplaceCatalog/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /avatarCatalog/{avatarId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // User profile root. Sensitive balances and entitlement data must not be
    // client-writable. Keep balance/XP/ownership in protected server-controlled
    // documents or update them only through a verified trusted transaction path.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'profile', 'preferences', 'onboarding', 'settings',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profile', 'preferences', 'onboarding', 'settings', 'updatedAt'
        ]);
      allow delete: if false;

      // Conservative default: private user subcollections can be read by their
      // owner, but writes are denied until the AI-generated schema and trusted
      // transaction endpoints have been reviewed and the rules are tightened
      // for each exact collection and field.
      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Deny all unspecified documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
